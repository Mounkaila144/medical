# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=medical
DB_SSL=false

# JWT Secrets - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=change_me_to_a_strong_random_secret
JWT_REFRESH_SECRET=change_me_to_another_strong_random_secret

# Server
PORT=3001
NODE_ENV=development

# CORS - Comma-separated list of allowed origins (leave empty for wildcard in dev)
CORS_ORIGINS=

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# Default Tenant (for public endpoints)
DEFAULT_TENANT_ID=

# Evolution API (WhatsApp notifications)
EVOLUTION_API_URL=http://your-evolution-api-host:8080
EVOLUTION_API_KEY=your_api_key_here
EVOLUTION_INSTANCE_NAME=your_instance_name
